{
  "name": "voice-agent",
  "version": "1.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "A local Windows assistant with explicit task permissions",
  "main": "./out/main/index.js",
  "author": "Sophon contributors",
  "scripts": {
    "smoke:browser": "node scripts/smoke-browser.cjs",
    "smoke:browser:native": "node scripts/smoke-browser-native.cjs",
    "smoke:updates": "node scripts/smoke-updates.cjs",
    "smoke:updates:ui": "electron scripts/smoke-updates-ui.cjs --hidden",
    "test": "node scripts/test.cjs",
    "icons:generate": "electron scripts/generate-icons.cjs",
    "smoke:icons": "node scripts/smoke-icons.cjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "setup:voice": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1",
    "smoke:voice": "node scripts/smoke-voice.cjs",
    "smoke:memory": "node scripts/smoke-memory.cjs",
    "smoke:notes": "node scripts/smoke-notes.cjs",
    "smoke:harness": "node scripts/smoke-harness.cjs",
    "smoke:plugins": "node scripts/smoke-plugins.cjs",
    "smoke:plugins:ui": "electron scripts/smoke-plugins-ui.cjs --hidden",
    "smoke:coding": "node scripts/smoke-coding.cjs",
    "smoke:project-commands": "node scripts/smoke-project-commands.cjs",
    "smoke:coding:connected": "electron scripts/smoke-connected-coding.cjs --hidden --live",
    "smoke:coding:quality": "node scripts/smoke-coding-quality.cjs",
    "smoke:coding:agent": "node scripts/smoke-coding-agent.cjs --live",
    "smoke:coding:deletion:live": "node scripts/smoke-coding-agent.cjs --live --delete",
    "smoke:coding:harness": "node scripts/smoke-coding-harness.cjs",
    "smoke:coding:resources": "node scripts/smoke-coding-resources.cjs",
    "smoke:coding:ui": "electron scripts/smoke-coding-ui.cjs --hidden",
    "smoke:questions": "electron scripts/smoke-questions-electron.cjs --hidden",
    "smoke:design-guide": "electron scripts/smoke-design-guide.cjs --hidden",
    "smoke:conversation": "node scripts/smoke-conversation.cjs",
    "smoke:compaction": "node scripts/smoke-compaction.cjs",
    "smoke:long-task-memory": "node scripts/smoke-long-task-memory.cjs",
    "smoke:streaming": "node scripts/smoke-streaming.cjs",
    "smoke:providers": "node scripts/smoke-providers.cjs",
    "smoke:model-insights": "node scripts/smoke-model-insights.cjs",
    "smoke:model-insights:ui": "electron scripts/smoke-model-insights-ui.cjs --hidden",
    "smoke:chatgpt": "node scripts/smoke-chatgpt.cjs",
    "smoke:capabilities": "node scripts/smoke-capabilities.cjs",
    "smoke:awareness": "node scripts/smoke-awareness.cjs",
    "smoke:apps": "node scripts/smoke-apps.cjs",
    "smoke:pages": "node scripts/smoke-pages.cjs",
    "smoke:pages:electron": "electron scripts/smoke-pages-electron.cjs --hidden",
    "smoke:assistant:journey": "electron scripts/smoke-assistant-native.cjs --hidden --live --browser --visual",
    "smoke:workflow": "node scripts/smoke-workflow.cjs",
    "smoke:controls": "node scripts/smoke-controls.cjs",
    "smoke:screen": "node scripts/smoke-screen.cjs",
    "smoke:controls:native": "node scripts/smoke-controls-native.cjs",
    "smoke:memory:electron": "electron scripts/smoke-memory-electron.cjs --hidden",
    "smoke:visual-replies": "node scripts/smoke-visual-replies.cjs",
    "smoke:visual-ui": "electron scripts/smoke-visual-ui.cjs --hidden",
    "smoke:security": "node scripts/smoke-security.cjs",
    "smoke:web": "node scripts/smoke-web.cjs",
    "smoke:exa": "node scripts/smoke-exa.cjs",
    "smoke:specialists": "node scripts/smoke-specialists.cjs",
    "smoke:security:electron": "electron scripts/smoke-security-electron.cjs --hidden",
    "smoke:desktop": "electron-vite dev --entry scripts/smoke-desktop.cjs",
    "smoke:formatting": "electron scripts/smoke-formatting.cjs --hidden",
    "smoke:scroll-area": "electron scripts/smoke-scroll-area.cjs --hidden",
    "smoke:popups": "electron scripts/smoke-popups.cjs --hidden",
    "smoke:popups:dev": "electron-vite dev --entry scripts/smoke-popups.cjs -- --hidden",
    "smoke:assistant:native": "electron scripts/smoke-assistant-native.cjs --hidden",
    "smoke:assistant:live": "electron scripts/smoke-assistant-native.cjs --hidden --live",
    "smoke:tools:live": "npm run build && electron scripts/smoke-assistant-native.cjs --hidden --live --tools-only",
    "build": "npm run typecheck && npm run licenses:generate && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && node scripts/security/release.cjs",
    "build:win:unsigned": "npm run build && node scripts/security/release.cjs --unsigned",
    "licenses:generate": "node scripts/third-party-notices.cjs",
    "licenses:check": "node scripts/third-party-notices.cjs --check"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.11",
    "jose": "^6.2.13",
    "koffi": "^3.3.3",
    "parse5": "7.3.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "katex": "^0.16.47",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "motion": "^14.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
